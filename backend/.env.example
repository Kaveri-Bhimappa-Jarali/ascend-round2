# Environment settings for FastAPI application
ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Database
DATABASE_URL=sqlite:///./compliance_sentinel.db

# Cloud Mock settings (for testing/demo)
DEMO_MODE=True
AWS_DEMO_MODE=True
AWS_DEFAULT_REGION=us-east-1

# Optional AWS Credentials (if you set AWS_DEMO_MODE=False)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# GCP Settings
GCP_DEMO_MODE=True
GCP_DEFAULT_PROJECT=cloudcompliance-sentinel-demo
GOOGLE_APPLICATION_CREDENTIALS=
